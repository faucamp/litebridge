<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>test-project</artifactId>
    <version>1.0-SNAPSHOT</version>

    <build>
        <plugins>
            <plugin>
                <artifactId>litebridge-maven-plugin</artifactId>
                <configuration>
                    <database>
                        <url>jdbc:h2:mem:lb;DB_CLOSE_DELAY=-1</url>
                        <user>sa</user>
                        <password></password>
                        <databaseProviderClass>org.litebridge.db.h2.H2DatabaseProvider</databaseProviderClass>
                    </database>

                    <input>
                        <tables>
                            <table>LB.OS_AUTH</table>
                            <table>LB.OS_AUTH_GROUP</table>
                            <table>LB.OS_AUTH_SERVICE</table>
                            <table>LB.OS_AUTH_TYPE</table>
                            <table>LB.OS_CLIENT</table>
                            <table>LB.OS_CONFIG</table>
                            <table>LB.OS_CONFIG_TYPE</table>
                            <table>LB.OS_FEAT_APP</table>
                            <table>LB.OS_FEAT_CAT</table>
                            <table>LB.OS_FEAT_SERVICE</table>
                            <table>LB.OS_FEATURE</table>
                            <table>LB.OS_GROUP</table>
                            <table>LB.OS_HIST_FEATURE</table>
                            <table>LB.OS_HIST_HEALTHCHECK</table>
                            <table>LB.OS_HIST_SERVICE</table>
                            <table>LB.OS_HIST_SRV_CMPT</table>
                            <table>LB.OS_HIST_SRV_CNTB</table>
                            <table>LB.OS_HIST_SRV_DEP</table>
                            <table>LB.OS_HIST_SRV_INST</table>
                            <table>LB.OS_HIST_STAT_DET</table>
                            <table>LB.OS_MAINTENANCE</table>
                            <table>LB.OS_MNT_GROUP</table>
                            <table>LB.OS_MNT_SERVICE</table>
                            <table>LB.OS_SERV_COMPNT</table>
                            <table>LB.OS_SERVICE</table>
                            <table>LB.OS_SERVICE_CHECK</table>
                            <table>LB.OS_SERVICE_DEP</table>
                            <table>LB.OS_SERVICE_INSTANCE</table>
                            <table>LB.OS_SERVICE_TYPE</table>
                            <table>LB.OS_SRV_CHECK_TP</table>
                            <table>LB.OS_STATUS</table>
                            <table>LB.OS_TEST_REPORT</table>
                        </tables>
                    </input>

                    <sqlTypeMappings>
                        <sqlTypeMapping>
                            <jdbcType>NUMERIC</jdbcType>
                            <fieldType>java.lang.Long</fieldType>
                        </sqlTypeMapping>
                        <sqlTypeMapping>
                            <jdbcType>NUMERIC</jdbcType>
                            <precision>1</precision>
                            <notNull>true</notNull>
                            <fieldType>boolean</fieldType>
                        </sqlTypeMapping>
                        <sqlTypeMapping>
                            <jdbcType>NUMERIC</jdbcType>
                            <precision>1</precision>
                            <notNull>false</notNull>
                            <fieldType>java.lang.Boolean</fieldType>
                        </sqlTypeMapping>
                    </sqlTypeMappings>

                    <tableMappings>
                        <tableMapping>
                            <table>LB.OS_HIST_HEALTHCHECK</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_HEALTHCHECK_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_SERVICE</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_SERVICE_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_SRV_INST</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_SRV_INST_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_SRV_CMPT</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>OS_HIST_SRV_CMPT_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_FEATURE</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_FEATURE_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_STAT_DET</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_STAT_DET_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_SRV_DEP</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_SRV_DEP_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_HIST_SRV_CNTB</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>HIST_SRV_CNTB_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>

                        <tableMapping>
                            <table>LB.OS_TEST_REPORT</table>
                            <columnMappings>
                                <columnMapping>
                                    <column>TEST_REPORT_ID</column>
                                    <generateUsingSequence>LB.OS_SEQ</generateUsingSequence>
                                </columnMapping>
                            </columnMappings>
                        </tableMapping>
                    </tableMappings>

                    <output>
                        <outputDir>${project.build.directory}/generated-sources/java</outputDir>
                        <outputPackage>com.example.generated</outputPackage>
                        <jspecify>
                            <annotate>true</annotate>
                        </jspecify>
                    </output>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
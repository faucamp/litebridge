<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>test-project</artifactId>
    <version>1.0-SNAPSHOT</version>

    <build>
        <plugins>
            <plugin>
                <artifactId>litebridge-maven-plugin</artifactId>
                <configuration>
                    <input>
                        <srcDir>src/test/java</srcDir>
                        <inputPackages>
                            <inputPackage>org.litebridge.maven.test</inputPackage>
                        </inputPackages>
                    </input>
                    <output>
                        <outputPackage>org.litebridge.maven.test.meta</outputPackage>
                        <jspecify>
                            <annotate>true</annotate>
                        </jspecify>
                    </output>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
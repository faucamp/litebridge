---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import {Terminal, Database, Rocket, Settings, Box, Code2, Cpu} from '@lucide/astro';
import {CodeHintRegistry} from "../data/codeHints";
import CodeExample from "../components/CodeExample.astro";

const title = "Get Started with Litebridge";
const description = "Learn how to integrate Litebridge into your Java 21+ project.";

export const exampleCodeHints: CodeHintRegistry = {
    Person: {
        title: 'Person.java',
        description: 'Example entity class annotated with <code>@Table</code>, <code>@Column</code> and others, for <strong>declarative table mapping</strong>.',
        code: `@Table("LB.PERSON")
public class Person {
    @Column(value = "PERSON_ID", generateUsingSequence = "LB.PERSON_SEQ")
    private Long id;

    @Column("FIRST_NAME")
    private String name;

    @Column("SURNAME")
    private String surname;

    @OneToMany(mappedByField = "owner")
    private List<AccountEntity> accounts;

    public Long getId() { return id; }
    public void setId(Long id) { this.id = id; }

    public String getName() { return name; }
    public void setName(String name) { this.name = name; }

    public String getSurname() { return surname; }
    public void setSurname(String surname) { this.surname = surname; }

    public int getAge() { return age; }
    public void setAge(int age) { this.age = age; }

    public List<AccountEntity> getAccounts() { return accounts; }
    public void setAccounts(List<AccountEntity> accounts) { this.accounts = accounts; }
}`,
        lang: 'java',
        filename: 'PersonEntity.java',
    },
    Litebridge: {
        title: 'Litebridge.java',
        description: `The core entry point for fluent database operations (<code>select</code>, <code>insert</code>, <code>update</code>, <code>delete</code>, <code>merge</code>).

Typically instantiated using the <code>Litebridge.withDatabase()</code> builder method, or injected if using Spring.

Different database providers change the capabilities of Litebridge by extending or constraining its API:
`,
        code: `import org.litebridge.orm.Litebridge;
import org.litebridge.db.h2.H2DatabaseProvider;
import org.litebridge.db.h2.OracleDatabseProvider;
import org.litebridge.db.postgres.PostgresDatabaseProvider;
import org.litebridge.db.sqlite.SQLiteDatabaseProvider;

// For H2
Litebridge litebridge = Litebridge
    .withDatabaseProvider(
        new H2DatabaseProvider(), dataSource)
    .build();
    
// Oracle provides database-specific extensions to the 
// base Litebridge interface, such as "insertAll()"
LitebridgeOracle litebridge = Litebridge
    .withDatabaseProvider(
        new OracleDatabaseProvider(), dataSource)
    .build();

// For PostgreSQL
Litebridge litebridge = Litebridge
    .withDatabaseProvider(
        new PostgresDatabaseProvider(), dataSource)
    .build();

// SQLite uses LitebridgeCore as it does not have "merge" functionality
LitebridgeCore litebridge = Litebridge
    .withDatabaseProvider(
        new SQLiteDatabaseProvider(), dataSource)
    .build();
    `,
        lang: 'java',
        filename: 'Litebridge.java',
    },
}

const coreDependencyXml = `<dependency>
    <groupId>org.litebridgedb</groupId>
    <artifactId>litebridge-orm</artifactId>
    <version>0.4.0</version>
</dependency>`;

const databaseProviderDependencyXml = [
    {
        id: 'h2',
        title: 'H2',
        lang: 'xml',
        code: `<dependency>
    <groupId>org.litebridgedb</groupId>
    <artifactId>litebridge-db-h2</artifactId>
    <version>0.4.0</version>
</dependency>`
    },
    {
        id: 'oracle',
        title: 'Oracle',
        lang: 'xml',
        code: `<dependency>
    <groupId>org.litebridgedb</groupId>
    <artifactId>litebridge-db-oracle</artifactId>
    <version>0.4.0</version>
</dependency>`
    },
    {
        id: 'postgres',
        title: 'PostgreSQL',
        lang: 'xml',
        code: `<dependency>
    <groupId>org.litebridgedb</groupId>
    <artifactId>litebridge-db-postgres</artifactId>
    <version>0.4.0</version>
</dependency>`
    },
    {
        id: 'sqlite',
        title: 'SQLite',
        lang: 'xml',
        code: `<dependency>
    <groupId>org.litebridgedb</groupId>
    <artifactId>litebridge-db-sqlite</artifactId>
    <version>0.4.0</version>
</dependency>`
    }
]

const entityJavaCode = `import org.litebridge.orm.annotation.Column;
import org.litebridge.orm.annotation.Table;
import org.litebridge.orm.annotation.OneToMany;

@Table("LB.PERSON")
public class Person {

    @Column(value = "ID", generateUsingSequence = "PERSON_SEQ")
    private Long id;

    @Column("NAME")
    private String name;

    @Column("SURNAME")
    private String surname;
    
    @OneToMany(mappedByField = "owner")
    private List<Account> accounts;

    // Getters and setters
}`;

const initJavaCode = [
    {
        id: 'h2',
        title: 'H2',
        lang: 'java',
        code: `import javax.sql.DataSource;

import org.litebridge.orm.Litebridge;
import org.litebridge.db.h2.H2DatabaseProvider;

import org.example.entity.Person;

// Create a Litebridge instance
Litebridge litebridge = Litebridge
    .withDatabase(new H2DatabaseProvider(), dataSource)
    .build();

// Register your entities
litebridge.register(Person.class);`
    },
    {
        id: 'oracle',
        title: 'Oracle',
        lang: 'java',
        code: `import javax.sql.DataSource;

import org.litebridge.orm.Litebridge;
import org.litebridge.db.oracle.api.LitebridgeOracle;
import org.litebridge.db.oracle.OracleDatabaseProvider;

import org.example.entity.Person;

// Create a Litebridge instance with additional Oracle-specific extensions
LitebridgeOracle litebridge = Litebridge
    .withDatabase(new OracleDatabaseProvider(), dataSource)
    .build();

// Register your entities
litebridge.register(Person.class);`
    },
    {
        id: 'postgres',
        title: 'PostgreSQL',
        lang: 'java',
        code: `import javax.sql.DataSource;

import org.litebridge.orm.Litebridge;
import org.litebridge.db.postgres.PostgresDatabaseProvider;

import org.example.entity.Person;

// Create a Litebridge instance
Litebridge litebridge = Litebridge
    .withDatabase(new PostgresDatabaseProvider(), dataSource)
    .build();

// Register your entities
litebridge.register(Person.class);`
    },
    {
        id: 'sqlite',
        title: 'SQLite',
        lang: 'java',
        code: `import javax.sql.DataSource;

import org.litebridge.orm.Litebridge;
import org.litebridge.orm.LitebridgeCore;
import org.litebridge.db.sqlite.SQLiteDatabaseProvider;

import org.example.entity.Person;

// Create a Litebridge instance without "merge" support
LitebridgeCore litebridge = Litebridge
    .withDatabase(new SQLiteDatabaseProvider(), dataSource)
    .build();

// Register your entities
litebridge.register(Person.class);`
    },
]

const queryJavaCode = `import java.util.Optional;

import org.litebridge.orm.Litebridge;

import org.example.entity.Person;

// Save an entity
litebridge.save(person);

// Query data
Optional<Person> alice = litebridge.select(Person.class)
    .where("name").eq("Alice")
    .first();`;
---

<Layout title={title} description={description}>
    <div class="pt-32 pb-20 lg:pt-48 lg:pb-32">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
            <div class="mb-16 reveal">
                <h1 class="text-4xl font-extrabold tracking-tight text-primary dark:text-white sm:text-6xl mb-6">
                    Get Started
                </h1>
                <p class="text-xl text-gray-500 dark:text-gray-400">
                    This guide covers the basic steps to integrate Litebridge into a Java project, from setting up
                    dependencies to performing your first database operations.
                </p>
            </div>

            <div class="space-y-16">
                <!-- Prerequisites -->
                <section class="reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Settings class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">1. Requirements</h2>
                    </div>
                    <ul class="space-y-4 text-gray-600 dark:text-gray-400 text-lg">
                        <li class="flex items-start gap-3">
                            <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                            <span><strong>Java 21+</strong>: Leveraging modern features like records and pattern matching.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                            <span><strong>Maven</strong>: For dependency management and build automation.</span>
                        </li>
                    </ul>
                </section>

                <!-- Add Dependency -->
                <section class="reveal" style="transition-delay: 100ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Terminal class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">2. Add Litebridge</h2>
                    </div>
                    <p class="mb-4 text-gray-600 dark:text-gray-400">Add the core ORM dependency to your <code
                            class="bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded">pom.xml</code>:</p>
                    <CodeBlock filename="pom.xml" lang="xml" code={coreDependencyXml}/>
                </section>

                <!-- DB Provider -->
                <section class="reveal" style="transition-delay: 200ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Database class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">3. Choose a Provider</h2>
                    </div>
                    <p class="mb-6 text-gray-600 dark:text-gray-400">Include the artifact for your target database.
                        Litebridge supports the following providers:</p>
                    <CodeExample filename="pom.xml" examples={databaseProviderDependencyXml}/>
                </section>

                <!-- Define Entity -->
                <section class="reveal" style="transition-delay: 300ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Code2 class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">4. Define an Entity</h2>
                    </div>
                    <p class="mb-4 text-gray-600 dark:text-gray-400">Map your Java classes to database tables using
                        Litebridge annotations:</p>
                    <CodeBlock filename="Person.java" lang="java" code={entityJavaCode} class="mb-4"/>
                    <p class="text-gray-600 dark:text-gray-400 text-sm italic">Note: The Litebridge Maven plugin can
                        automatically generate these entities from your database schema.</p>
                    <p class="text-gray-600 dark:text-gray-400 text-sm italic">Plain, unaltered DTOs can also be used;
                        see the <a href="/mapping-entities">"Mapping tables to entities"</a> guide for more details.</p>
                </section>

                <!-- Initialise -->
                <section class="reveal" style="transition-delay: 400ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Cpu class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">5. Initialise</h2>
                    </div>
                    <p class="mb-4 text-gray-600 dark:text-gray-400">Create a <code
                            class="bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded">Litebridge</code> instance and
                        register your entities:</p>
                    <CodeExample filename="GetStarted.java" lang="java" examples={initJavaCode} hints={exampleCodeHints}/>
                </section>

                <!-- Operations -->
                <section class="reveal" style="transition-delay: 500ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Rocket class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">6. Persistence & Queries</h2>
                    </div>
                    <p class="mb-4 text-gray-600 dark:text-gray-400">You are now ready to save and retrieve data using
                        Litebridge's fluent API:</p>
                    <CodeBlock filename="GetStarted.java" lang="java" code={queryJavaCode}/>
                </section>

                <!-- Next Steps -->
                <section class="reveal" style="transition-delay: 600ms">
                    <div class="rounded-3xl bg-primary/5 dark:bg-accent/5 p-8 lg:p-12 border border-primary/10 dark:border-accent/10">
                        <div class="flex items-center gap-4 mb-6">
                            <Box class="h-8 w-8 text-accent"/>
                            <h2 class="text-3xl font-bold text-primary dark:text-white">Next Steps</h2>
                        </div>
                        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
                            Explore the full functionality of Litebridge:
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href="/examples"
                               class="rounded-full bg-primary px-6 py-3 font-bold text-white transition-all hover:bg-primary/90 dark:bg-accent dark:text-primary">
                                Code Examples
                            </a>
                            <a href="https://github.com/faucamp/litebridge/blob/main/docs/index.md"
                               class="rounded-full border border-primary/20 px-6 py-3 font-bold text-primary transition-all hover:bg-primary/5 dark:border-accent/20 dark:text-accent">
                                Full Documentation
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s ease-out;
    }

    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

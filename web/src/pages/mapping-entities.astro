---
import Layout from '../layouts/Layout.astro';
import {ArrowLeft, Database} from '@lucide/astro';
import CodeExample from '../components/CodeExample.astro';

const title = "Annotated entities";
const description = "Annotated entity examples";

const entityExamples = [
    {
        id: 'exampleEntities',
        title: 'Entities',
        animate: false,
        filename: 'Person.java / Account.java',
        description: `Litebridge entities are classes decorated with annotations to define their mapping to tables and columns, and relationships with other entities.
<br/><br/>         
Fields or property getter methods may be annotated.`,
        code: `import org.litebridge.orm.annotation.Column;
import org.litebridge.orm.annotation.Table;
import org.litebridge.orm.annotation.OneToMany;

// Person.java
@Table("LB.PERSON")
public class Person {

    @Column(value = "ID", generateUsingSequence = "LB.PERSON_SEQ")
    private Long id;

    @Column("NAME")
    private String name;

    @Column("SURNAME")
    private String surname;
    
    @OneToMany(mappedByField = "owner")
    private List<Account> accounts;

    // Getters and setters
}

// Account.java
@Table("LB.ACCOUNT")
public class Account {

    @Column(value = "ACCOUNT_ID", generateUsingSequence = "LB.ACCOUNT_SEQ")
    private Long id;
    
    @Column("ACCOUNT_NAME")
    private String name;
    
    @Column("BALANCE")
    private BigInteger balance;
    
    @Column(value = "PERSON_ID", joinUsing = true)
    private Person owner;
    
    // Getters and setters
}`
    },
    {
        id: 'exampleMetaModels',
        title: 'Metamodels',
        description: `Litebridge metamodels provide static query expressions for <strong>type-safe query formulation</strong>.
<br/>
<br/>
They are optional to use, and can be hand-crafted or generated from existing entities using the Litebridge Maven plugin's <code>metamodel</code> goal.
`,
        animate: false,
        filename: 'PersonMeta.java / AccountMeta.java',
        code: `import org.litebridge.orm.meta.NumericQueryField;
import org.litebridge.orm.meta.StringQueryField;
import org.litebridge.orm.meta.QueryField;

import org.example.entity.Person;
import org.example.entity.Account;

// PersonMeta.java
public final class PersonMeta {
    public static final NumericQueryField id = new NumericQueryField(Person.class, "id");
    public static final StringQueryField name = new StringQueryField(Person.class, "name");
    public static final StringQueryField surname = new StringQueryField(Person.class, "surname");
    public static final NumericQueryField age = new NumericQueryField(Person.class, "age");
    public static final QueryField accounts = new QueryField(Person.class, "accounts");
}

// AccountMeta.java
public class AccountMeta {
    public static final NumericQueryField id = new NumericQueryField(Account.class, "id");
    public static final StringQueryField name = new StringQueryField(Account.class, "name");
    public static final NumericQueryField balance = new NumericQueryField(Account.class, "balance");
    public static final QueryField owner = new QueryField(Account.class, "owner");
}

// Example type-safe query using the Person metamodel
litebridge.select(PersonMeta.id, PersonMeta.name).from(Person.class).list();

// The same query, but using field names directly instead of a metamodel
litebridge.select("id", "name").from(Person.class).list();`
    },
    {
        id: 'maven',
        title: 'Reverse engineering',
        description: `The Litebridge Maven plugin allows entities to be created by reverse engineering existing database tables.
<br/><br/>
It provides two goals: <code>reverse-engineer</code> and <code>metamodel</code>.
<br/><br/>
The <code>reverse-engineer</code> goal generates Litebridge entity classes from database tables, 
and the <code>metamodel</code> goal generates metamodels from entities.`,
        filename: 'pom.xml',
        lang: `xml`,
        animate: false,
        code: `<!-- Inside pom.xml <build><plugins> section -->
<plugin>
    <groupId>org.litebridgedb.maven</groupId>
    <artifactId>litebridge-maven-plugin</artifactId>
    <executions>
        <!-- Generate Litebridge entities -->
        <execution>
            <id>Reverse engineer Litebridge entities</id>
            <goals>
                <goal>reverse-engineer</goal>
            </goals>
            <configuration>
                <!-- Source database setup -->
                <database>
                    <url>jdbc:h2:file:./target/h2/lb</url>
                    <user>sa</user>
                    <password></password>
                    <!-- Specify the Litebridge database provider class -->
                    <databaseProviderClass>org.litebridge.db.h2.H2DatabaseProvider</databaseProviderClass>
                </database>

                <!-- Specify input tables to reverse engineer -->
                <input>
                    <tables>
                        <table>LB.PERSON</table>
                        <table>LB.ACCOUNT</table>
                    </tables>
                </input>

                <!-- Optional: override global database type mappings -->
                <sqlTypeMappings>
                    <sqlTypeMapping>
                        <jdbcType>NUMERIC</jdbcType>
                        <fieldType>java.lang.Long</fieldType>
                    </sqlTypeMapping>
                    <sqlTypeMapping>
                        <jdbcType>NUMERIC</jdbcType>
                        <precision>1</precision>
                        <notNull>true</notNull>
                        <fieldType>boolean</fieldType>
                    </sqlTypeMapping>
                    <sqlTypeMapping>
                        <jdbcType>NUMERIC</jdbcType>
                        <precision>1</precision>
                        <notNull>false</notNull>
                        <fieldType>java.lang.Boolean</fieldType>
                    </sqlTypeMapping>
                </sqlTypeMappings>

                <!-- Specify table-to-entity mappings. Each table has a <tableMapping> element. -->
                <tableMappings>
                    <tableMapping>
                        <table>LB.PERSON</table>
                        <!-- Column-to-entity field mappings -->
                        <columnMappings>
                            <columnMapping>
                                <column>PERSON_ID</column>
                                <fieldName>id</fieldName>
                                <!-- Indicates that the specified database sequence should be used to generate values for the "id" field -->
                                <generateUsingSequence>LB.PERSON_SEQ</generateUsingSequence>
                            </columnMapping>
                            <columnMapping>
                                <column>AGE</column>
                                <!-- Override the target field type for the "AGE" column specifically -->
                                <fieldType>int</fieldType>
                            </columnMapping>
                        </columnMappings>
                    </tableMapping>

                    <tableMapping>
                        <table>LB.ACCOUNT</table>
                        <columnMappings>
                            <columnMapping>
                                <column>ACCOUNT_ID</column>
                                <fieldName>id</fieldName>
                                <generateUsingSequence>LB.ACCOUNT_SEQ</generateUsingSequence>
                            </columnMapping>
                            <columnMapping>
                                <column>PERSON_ID</column>
                                <fieldName>owner</fieldName>
                            </columnMapping>
                            <columnMapping>
                                <column>BALANCE</column>
                                <fieldType>java.math.BigDecimal</fieldType>
                            </columnMapping>
                        </columnMappings>
                    </tableMapping>
                </tableMappings>

                <!-- Specify output directory and package for generated entities -->
                <output>
                    <outputDir>\${project.build.directory}/generated-sources/java</outputDir>
                    <outputPackage>org.example.entity</outputPackage>
                </output>
            </configuration>
        </execution>

        <!-- Create Litebridge entity metamodels -->
        <execution>
            <id>Create Litebridge entity metamodels</id>
            <goals>
                <goal>metamodel</goal>
            </goals>

            <configuration>
                <!-- Specify the input directory and packages containing entities to create metamodels for -->
                <input>
                    <srcDir>\${project.build.directory}/generated-sources/java</srcDir>
                    <inputPackages>
                        <inputPackage>org.example.entity</inputPackage>
                    </inputPackages>
                </input>
                <!-- Specify the output directory and package for generated metamodels -->
                <output>
                    <outputDir>\${project.build.directory}/generated-sources/java</outputDir>
                    <outputPackage>org.example.metamodel</outputPackage>
                </output>
            </configuration>
        </execution>
    </executions>
</plugin>`
    },
    {
        id: 'exampleTables',
        title: 'Example tables',
        animate: false,
        filename: 'create-tables.sql',
        description: `DDL for examples:`,
        lang: 'sql',
        code: `CREATE SEQUENCE LB.PERSON_SEQ START WITH 1 MAXVALUE 999 INCREMENT BY 1;
CREATE SEQUENCE LB.ACCOUNT_SEQ START WITH 1 MAXVALUE 999 INCREMENT BY 1;

CREATE TABLE LB.PERSON
(
    PERSON_ID  NUMBER(10)    NOT NULL PRIMARY KEY,
    FIRST_NAME VARCHAR2(255) NOT NULL,
    SURNAME    VARCHAR2(255),
    AGE        NUMBER(3),
);

CREATE TABLE LB.ACCOUNT
(
    ACCOUNT_ID   NUMBER(10)    NOT NULL PRIMARY KEY,
    ACCOUNT_NAME VARCHAR2(255) NOT NULL,
    BALANCE      NUMBER(10)    NOT NULL,
    PERSON_ID    NUMBER(10)    NOT NULL REFERENCES LB.PERSON (PERSON_ID)
);`
    }
];

const registerExamples = [
    {
        id: 'direct',
        title: 'Direct registration',
        description: `Entities can be registered directly using the <code>register</code> method.`,
        filename: 'RegistrationExample.java',
        lang: 'java',
        code: `import org.example.entity.Person;
import org.example.entity.Account;

// Register a single entity
litebridge.register(Person.class);

// Register multiple entities
litebridge.register(Person.class, Account.class);`
    },
    {
        id: 'packageScan',
        title: 'Package scanning',
        description: `The <code>litebridge-orm-support</code> module contains the <code>EntityScanner</code> utility class,
  which allows packages to be scanned for entities, and for these entities to be registered automatically.`,
        filename: 'ScannerExample.java',
        lang: 'java',
        code: `import org.litebridge.orm.support.EntityScanner;

// Create an entity scanner for the Litebridge instance
EntityScanner scanner = new EntityScanner(litebridge);

// Scan and register all entity classes in the specified packages
scanner.scanBasePackage("org.example.entity")`
    },
    {
        id: 'springBoot',
        title: 'Spring Boot',
        description: `The Litebridge Spring Boot starter provides configuration properties to automatically scan packages for entities to register.
<br/><br/>
The <code>litebridge.scan-base-packages</code> property in <code>application.yml</code>/<code>application.properties</code> specifies the packages to scan:`,
        filename: 'application.yml',
        lang: 'yaml',
        code: `litebridge:
  scan-base-package:
    - org.example.entity
    - org.example.other`
    }
];
---

<Layout title={title} description={description}>
    <div class="pt-32 pb-20 lg:pt-48 lg:pb-32">
        <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
            <div class="mb-12 reveal">
                <a
                        href="/mapping"
                        class="inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-accent dark:text-gray-400 dark:hover:text-accent transition-colors mb-6"
                >
                    <ArrowLeft class="h-4 w-4"/>
                    Back to mapping overview
                </a>
                <h1 class="text-4xl font-extrabold tracking-tight text-primary dark:text-white sm:text-6xl mb-6">
                    Annotated entities
                </h1>
                <p class="text-xl text-gray-500 dark:text-gray-400">
                    Use annotations to map entities to tables declaratively.
                </p>
            </div>

            <div class="space-y-16">
                <!-- Creating entities -->
                <section class="reveal" style="transition-delay: 100ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Database class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">Creating entities</h2>
                    </div>
                    <CodeExample showHintsDefault={false} examples={entityExamples}/>
                </section>

                <!-- Registering entities -->
                <section class="reveal" style="transition-delay: 100ms">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
                            <Database class="h-6 w-6"/>
                        </div>
                        <h2 class="text-3xl font-bold text-primary dark:text-white">Registering entities</h2>
                    </div>
                    <CodeExample examples={registerExamples}/>
                </section>
            </div>
        </div>
    </div>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s ease-out;
    }

    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

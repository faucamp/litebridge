---
import Layout from '../layouts/Layout.astro';
import { Search, PenTool, GitMerge, Layers, Settings, ArrowRight, Rocket, Wrench, DatabaseSearch } from '@lucide/astro';
import CodeBlock from "../components/CodeBlock.astro";

const title = "Code Examples";
const description = "Learn how to use Litebridge through code examples";

const commonExampleCode = `import javax.sql.DataSource;

import org.litebridge.orm.Litebridge;
import org.litebridge.db.h2.H2DatabaseProvider;
import org.litebridge.db.spi.Row;

// Example Person entity and metamodel
import org.example.entity.Person;
import org.example.meta.PersonMeta; 

// Assuming "dataSource" is a valid javax.sql.DataSource instance
Litebridge litebridge = Litebridge.withDatabaseProvider(
        new H2DatabaseProvider(), 
        dataSource)
    .build();
`;

const exampleCategories = [
  {
    title: 'Querying data',
    description: "Retrieve records and DTOs using Litebridge's fluent SELECT API or native SQL.",
    href: '/select',
    icon: Search,
  },
  {
    title: 'Updating data',
    description: 'Execute insert and update operations with automatic change tracking or direct SQL.',
    href: '/update',
    icon: PenTool,
  },
  // {
  //   title: 'Merging data',
  //   description: 'Perform upsert operations to insert or update records efficiently.',
  //   href: '/merge',
  //   icon: GitMerge,
  // },
  // {
  //   title: 'Entity mapping',
  //   description: 'Map database tables to Java records, plain DTOs, or annotated entities.',
  //   href: '/mapping',
  //   icon: Layers,
  // },
];
---

<Layout title={title} description={description}>
  <div class="pt-32 pb-20 lg:pt-48 lg:pb-32">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <h1 class="text-4xl font-extrabold tracking-tight text-primary dark:text-white sm:text-6xl mb-6">
          Code Examples
        </h1>
        <p class="text-xl text-gray-500 dark:text-gray-400">
          Explore code snippets and patterns for working with Litebridge in Java.
        </p>
      </div>

      <!-- Getting Started Callout -->
      <div class="rounded-2xl bg-primary/5 dark:bg-accent/5 p-6 border border-primary/10 dark:border-accent/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-16 reveal">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
            <Rocket class="h-5 w-5" />
          </div>
          <div>
            <h3 class="text-base font-bold text-primary dark:text-white">Setting up Litebridge from scratch?</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mt-0.5">
              Check out the Getting Started guide for Maven dependencies, provider setup, and project configuration.
            </p>
          </div>
        </div>
        <a
          href="/get-started"
          class="inline-flex items-center gap-2 whitespace-nowrap rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary/90 dark:bg-accent dark:text-primary dark:hover:bg-accent/90"
        >
          Get Started
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>

      <div class="space-y-16">
        <!-- Interactive Card Grid -->
        <section class="reveal">
          <h2 class="text-2xl font-bold text-primary dark:text-white mb-6">Browse Examples</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {exampleCategories.map((category) => (
              <a
                href={category.href}
                class="group relative rounded-2xl border border-gray-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-accent hover:shadow-xl dark:border-gray-800 dark:bg-dark-bg flex flex-col justify-between"
              >
                <div>
                  <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/5 text-primary transition-colors group-hover:bg-primary group-hover:text-white dark:bg-accent/5 dark:text-accent dark:group-hover:bg-accent dark:group-hover:text-primary">
                    <category.icon class="h-6 w-6" />
                  </div>
                  <h3 class="text-xl font-bold text-primary dark:text-white group-hover:text-accent transition-colors flex items-center justify-between">
                    {category.title}
                    <ArrowRight class="h-5 w-5 opacity-0 -translate-x-2 transition-all group-hover:opacity-100 group-hover:translate-x-0 text-accent" />
                  </h3>
                  <p class="mt-2 text-gray-600 dark:text-gray-400 text-sm">
                    {category.description}
                  </p>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800/60 flex items-center text-xs font-semibold text-accent">
                  View examples &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- Concepts -->
        <section class="reveal">
          <div class="flex items-center gap-4 mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
              <Settings class="h-6 w-6" />
            </div>
            <h2 class="text-3xl font-bold text-primary dark:text-white">Core Concepts</h2>
          </div>
          <p class="mb-4 text-gray-600 dark:text-gray-400">
            Litebridge's API has 2 primary modes of operation, as well as native SQL execution:
          </p>
          <ul class="space-y-4 text-gray-600 dark:text-gray-400">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
              <span><strong>DTO mode</strong>: Full ORM support. Queries return mapped DTOs/entities, and operations are executed against registered DTO/entity metadata. Provides type safety using Litebridge metamodels, but can be used without.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
              <span><strong>SQL mode</strong>: Operations are executed directly against tables and columns using the same fluent API; no DTO mapping required.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
              <span><strong>Native SQL</strong>: Direct execution of native SQL statements with support for positional or named bind parameters.</span>
            </li>
          </ul>
        </section>
        <section class="reveal">
          <div class="flex items-center gap-4 mb-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary dark:bg-accent/10 dark:text-accent">
              <Wrench class="h-6 w-6" />
            </div>
            <h2 class="text-3xl font-bold text-primary dark:text-white">Example setup</h2>
          </div>
          <p class="mb-4 text-gray-600 dark:text-gray-400">
            The examples in this documentation use common imports and initialisation code:
          </p>
          <CodeBlock filename="ExampleBase.java" code={commonExampleCode}/>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

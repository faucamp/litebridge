---
import { Zap, Cpu, BarChart3, Layers, Code2, Leaf, Box } from '@lucide/astro';

const features = [
  {
    title: 'Transparent Mapping',
    description: 'Use traditional annotated entities, or map DTOs to databases without modifying domain classes.',
    icon: Layers,
  },
  {
    title: 'Fluent API',
    description: 'Compose queries using a natural, SQL-like fluent builder that feels like writing SQL in Java.',
    icon: Code2,
  },
  {
    title: 'Lightweight',
    description: 'A pure Java library with minimal external dependencies, keeping projects lean.',
    icon: Zap,
  },
  {
    title: 'Efficient',
    description: 'Focuses on performance and minimising database round-trips via built-in DTO change tracking.',
    icon: BarChart3,
  },
  {
    title: 'Spring Integration',
    description: 'Seamlessly integrate with Spring Boot applications using the dedicated starter module.',
    icon: Leaf,
  },
  {
    title: 'Maven Plugin',
    description: 'Reverse engineer database schemas and generate type-safe metamodels for compile-time safety.',
    icon: Box,
  },
];
---

<section id="features" class="py-24 bg-gray-50 dark:bg-dark-bg/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 class="text-base font-semibold uppercase tracking-wider text-accent">Features</h2>
      <p class="mt-2 text-3xl font-extrabold tracking-tight text-primary dark:text-white sm:text-4xl">
        Built for Modern Java Persistence
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-xl text-gray-500 dark:text-gray-400">
        Litebridge balances relational power with the simplicity of plain Java objects.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature, index) => (
        <div 
          class="reveal group relative rounded-2xl border border-gray-200 bg-white p-8 transition-all hover:-translate-y-1 hover:shadow-xl dark:border-gray-800 dark:bg-dark-bg"
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/5 text-primary transition-colors group-hover:bg-primary group-hover:text-white dark:bg-accent/5 dark:text-accent dark:group-hover:bg-accent dark:group-hover:text-primary">
            <feature.icon class="h-6 w-6" />
          </div>
          <h3 class="text-xl font-bold text-primary dark:text-white">{feature.title}</h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

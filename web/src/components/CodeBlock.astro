---
import { Code } from 'astro:components';

export interface Props {
  code: string;
  lang?: string;
  filename?: string;
  id?: string;
  class?: string;
}

const {
  code,
  lang = 'java',
  filename = 'LitebridgeExample.java',
  id,
  class: className = '',
} = Astro.props;
---

<div
  class={`code-block-wrapper overflow-hidden rounded-2xl bg-gray-900 shadow-2xl border border-gray-800 w-full ${className}`}
  data-code-block
  id={id}
>
  <div class="code-window-header flex items-center justify-between bg-gray-800/80 px-4 py-2.5 border-b border-gray-700/50">
    <div class="flex gap-1.5">
      <div class="h-3 w-3 rounded-full bg-red-500/60"></div>
      <div class="h-3 w-3 rounded-full bg-yellow-500/60"></div>
      <div class="h-3 w-3 rounded-full bg-green-500/60"></div>
    </div>
    <span class="text-xs font-mono text-gray-400 code-filename">{filename}</span>
  </div>
  <div class="p-6 overflow-x-auto min-h-[140px]">
    <div class="code-content">
      <Code code={code} lang={lang} theme="github-dark" />
    </div>
  </div>
</div>

<script>
  function initCodeBlocks() {
    const blocks = document.querySelectorAll<HTMLElement>('[data-code-block]');

    blocks.forEach((block) => {
      if (block.dataset.codeBlockInit === 'true') return;
      block.dataset.codeBlockInit = 'true';

      const content = block.querySelector<HTMLElement>('.code-content');
      if (!content) return;

      const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT, null);
      const nodes: Text[] = [];
      let node: Node | null;
      while ((node = walker.nextNode())) {
        nodes.push(node as Text);
      }

      let charIndex = 0;
      nodes.forEach((textNode) => {
        const text = textNode.nodeValue || '';
        const fragment = document.createDocumentFragment();
        for (let i = 0; i < text.length; i++) {
          const charSpan = document.createElement('span');
          charSpan.textContent = text[i];
          charSpan.className = 'code-char';
          charSpan.style.transitionDelay = `${charIndex * 10}ms`;
          fragment.appendChild(charSpan);
          charIndex++;
        }
        textNode.parentNode?.replaceChild(fragment, textNode);
      });

      function triggerAnimation() {
        block.classList.remove('typing-active');
        void block.offsetWidth; // Force reflow
        block.classList.add('typing-active');
      }

      block.addEventListener('code-block:animate', () => {
        triggerAnimation();
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              if (block.offsetParent !== null) {
                triggerAnimation();
                observer.unobserve(entry.target);
              }
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(block);
    });
  }

  initCodeBlocks();
  document.addEventListener('astro:page-load', initCodeBlocks);
</script>

<style>
  :global(.code-char) {
    opacity: 0;
    transition: opacity 0.05s linear;
  }

  :global(.typing-active .code-char) {
    opacity: 1;
  }

  :global(.code-content .astro-code) {
    background-color: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 0.9rem !important;
    line-height: 1.6 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.code-char) {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
